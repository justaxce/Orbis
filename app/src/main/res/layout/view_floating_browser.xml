<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Browser URL Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp">

        <ImageButton
            android:id="@+id/btnBrowserBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <EditText
            android:id="@+id/etBrowserUrl"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_header"
            android:paddingHorizontal="8dp"
            android:hint="Search or type URL"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri" />

        <ImageButton
            android:id="@+id/btnBrowserRefresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbBrowserLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:visibility="gone" />

    <!-- Custom Text Selection Toolbar (Appears on text selection) -->
    <LinearLayout
        android:id="@+id/llSelectionToolbar"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@color/surface_elevated"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedTextPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/btnCopySelection"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/action_copy"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSearchSelection"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/action_search"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/btnClearSelection"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:padding="4dp"
            android:contentDescription="Dismiss" />
    </LinearLayout>

    <!-- Web View -->
    <WebView
        android:id="@+id/wvBrowser"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
