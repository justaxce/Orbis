<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="10dp">

    <!-- Top Mode Selector Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_status_badge"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnModeStandard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/calc_tab_standard"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_header"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnModeScientific"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/calc_tab_scientific"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnModeHistory"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/calc_tab_history"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Angle Toggle: DEG / RAD -->
        <TextView
            android:id="@+id/btnAngleUnit"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_status_badge"
            android:gravity="center"
            android:text="DEG"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Dual-Line OLED Display Card -->
    <LinearLayout
        android:id="@+id/llDisplayCard"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@drawable/bg_header"
        android:orientation="vertical"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:layout_marginBottom="8dp">

        <HorizontalScrollView
            android:id="@+id/hsvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvCalcExpression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text=""
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:singleLine="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvCalcResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Container for Keypad or History -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Calculator Keypad Layout -->
        <LinearLayout
            android:id="@+id/llKeypadContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Collapsible Scientific Panel -->
            <LinearLayout
                android:id="@+id/llScientificPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="6dp">

                <!-- Row 1: sin, cos, tan, ln, log, ( -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button android:id="@+id/btnCalcSin" android:text="sin" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:padding="0dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcCos" android:text="cos" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:padding="0dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcTan" android:text="tan" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:padding="0dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcLn" android:text="ln" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:padding="0dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcLog" android:text="log" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:padding="0dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcOpenParen" android:text="(" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:padding="0dp" android:textColor="@color/accent" />
                </LinearLayout>

                <!-- Row 2: √, x², ^, π, e, ) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal">

                    <Button android:id="@+id/btnCalcSqrt" android:text="√" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:padding="0dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcSq" android:text="x²" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="11sp" android:padding="0dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcPower" android:text="^" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:padding="0dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcPi" android:text="π" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:padding="0dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcE" android:text="e" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:padding="0dp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcCloseParen" android:text=")" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textSize="12sp" android:padding="0dp" android:textColor="@color/accent" />
                </LinearLayout>
            </LinearLayout>

            <!-- Standard 4x5 Keypad Grid -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:stretchColumns="*">

                <!-- Row 1: C, ⌫, %, ÷ -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btnCalcClear" android:text="C" android:textColor="@color/error" style="@style/Widget.Material3.Button.TonalButton" android:textSize="14sp" />
                    <Button android:id="@+id/btnCalcBackspace" android:text="⌫" style="@style/Widget.Material3.Button.TonalButton" android:textSize="14sp" />
                    <Button android:id="@+id/btnCalcPercent" android:text="%" style="@style/Widget.Material3.Button.TonalButton" android:textSize="14sp" />
                    <Button android:id="@+id/btnCalcDiv" android:text="÷" android:textColor="@color/accent" style="@style/Widget.Material3.Button.TonalButton" android:textSize="17sp" />
                </TableRow>

                <!-- Row 2: 7, 8, 9, × -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btnCalc7" android:text="7" style="@style/Widget.Material3.Button.TextButton" android:textSize="16sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalc8" android:text="8" style="@style/Widget.Material3.Button.TextButton" android:textSize="16sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalc9" android:text="9" style="@style/Widget.Material3.Button.TextButton" android:textSize="16sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalcMul" android:text="×" android:textColor="@color/accent" style="@style/Widget.Material3.Button.TonalButton" android:textSize="17sp" />
                </TableRow>

                <!-- Row 3: 4, 5, 6, − -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btnCalc4" android:text="4" style="@style/Widget.Material3.Button.TextButton" android:textSize="16sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalc5" android:text="5" style="@style/Widget.Material3.Button.TextButton" android:textSize="16sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalc6" android:text="6" style="@style/Widget.Material3.Button.TextButton" android:textSize="16sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalcSub" android:text="−" android:textColor="@color/accent" style="@style/Widget.Material3.Button.TonalButton" android:textSize="17sp" />
                </TableRow>

                <!-- Row 4: 1, 2, 3, + -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btnCalc1" android:text="1" style="@style/Widget.Material3.Button.TextButton" android:textSize="16sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalc2" android:text="2" style="@style/Widget.Material3.Button.TextButton" android:textSize="16sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalc3" android:text="3" style="@style/Widget.Material3.Button.TextButton" android:textSize="16sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalcAdd" android:text="+" android:textColor="@color/accent" style="@style/Widget.Material3.Button.TonalButton" android:textSize="17sp" />
                </TableRow>

                <!-- Row 5: 0, ., ±, = -->
                <TableRow android:layout_weight="1">
                    <Button android:id="@+id/btnCalc0" android:text="0" style="@style/Widget.Material3.Button.TextButton" android:textSize="16sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalcDot" android:text="." style="@style/Widget.Material3.Button.TextButton" android:textSize="18sp" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnCalcPlusMinus" android:text="±" style="@style/Widget.Material3.Button.TextButton" android:textSize="15sp" android:textColor="@color/text_secondary" />
                    <Button android:id="@+id/btnCalcEquals" android:text="=" style="@style/Widget.Material3.Button" android:textSize="18sp" android:textColor="#090B0E" app:backgroundTint="@color/accent" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- History Panel (Overlays keypad when History mode is active) -->
        <LinearLayout
            android:id="@+id/llHistoryPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/surface"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCalcHistory"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHistoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/calc_history_empty"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnClearHistory"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="@string/calc_clear_history"
                android:textColor="@color/error"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
