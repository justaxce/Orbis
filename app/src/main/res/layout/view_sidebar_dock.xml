<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dockRoot"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sidebar_dock"
    android:paddingVertical="12dp"
    android:paddingHorizontal="6dp"
    android:gravity="center_horizontal"
    android:elevation="12dp">

    <!-- Scrollable Selected Apps -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/llAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal" />
    </ScrollView>

    <!-- Divider -->
    <View
        android:layout_width="50dp"
        android:layout_height="1dp"
        android:background="#33818CF8"
        android:layout_marginVertical="8dp" />

    <!-- Built-in Floating Tools -->
    <LinearLayout
        android:id="@+id/btnToolBrowser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_browser"
            android:contentDescription="Floating Browser" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browser"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnToolCalculator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_calculator"
            android:contentDescription="Calculator" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calc"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnToolFlashlight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivFlashlightIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_flashlight"
            android:contentDescription="Flashlight" />

        <TextView
            android:id="@+id/tvFlashlightText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Torch"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- All Apps Drawer Button -->
    <LinearLayout
        android:id="@+id/btnToolAllApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_all_apps"
            android:contentDescription="All Apps" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Apps"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Add Apps Button -->
    <LinearLayout
        android:id="@+id/btnAddApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_add"
            android:contentDescription="Add Apps" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add"
            android:textColor="@color/primary_light"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
