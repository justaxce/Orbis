<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/windowRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_floating_window">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Slim 34dp Minimal Header Bar -->
        <LinearLayout
            android:id="@+id/windowHeader"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bg_header"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/ivHeaderIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="App Icon" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Keyboard Focus Toggle Button -->
            <ImageButton
                android:id="@+id/btnKeyboard"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_keyboard"
                android:padding="5dp"
                android:contentDescription="@string/keyboard_toggle_hint" />

            <!-- Minimize Button -->
            <ImageButton
                android:id="@+id/btnMinimize"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minimize"
                android:padding="5dp"
                android:contentDescription="Minimize" />

            <!-- Maximize Button -->
            <ImageButton
                android:id="@+id/btnMaximize"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_maximize"
                android:padding="5dp"
                android:contentDescription="Maximize" />

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:padding="5dp"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Content Frame -->
        <FrameLayout
            android:id="@+id/windowContentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/black" />
    </LinearLayout>

    <!-- Bottom-Right Minimal Resize Handle -->
    <ImageView
        android:id="@+id/ivResizeHandle"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="2dp"
        android:src="@drawable/ic_resize"
        android:contentDescription="Resize Handle" />
</FrameLayout>
