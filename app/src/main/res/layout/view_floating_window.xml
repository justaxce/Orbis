<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/windowRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_floating_window">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Slim 34dp Minimal Header Bar -->
        <LinearLayout
            android:id="@+id/windowHeader"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bg_header"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/ivHeaderIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="App Icon" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Keyboard Focus Toggle Button -->
            <ImageButton
                android:id="@+id/btnKeyboard"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_keyboard"
                android:padding="5dp"
                android:contentDescription="@string/keyboard_toggle_hint" />

            <!-- Minimize Button -->
            <ImageButton
                android:id="@+id/btnMinimize"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minimize"
                android:padding="5dp"
                android:contentDescription="Minimize" />

            <!-- Maximize Button -->
            <ImageButton
                android:id="@+id/btnMaximize"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_maximize"
                android:padding="5dp"
                android:contentDescription="Maximize" />

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:padding="5dp"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Content Frame -->
        <FrameLayout
            android:id="@+id/windowContentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/black" />
    </LinearLayout>

    <!-- Live 9:16 Dimensions Badge Overlay -->
    <TextView
        android:id="@+id/tvResizeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_status_badge"
        android:backgroundTint="#E612161F"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:elevation="12dp"
        android:visibility="gone" />

    <!-- Bottom-Left Crop Corner Handle (40dp Touch Hitbox) -->
    <FrameLayout
        android:id="@+id/flResizeBL"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|start"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivResizeBL"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_resize_corner_bl"
            android:contentDescription="Crop Resize Bottom Left" />
    </FrameLayout>

    <!-- Bottom-Right Crop Corner Handle (40dp Touch Hitbox) -->
    <FrameLayout
        android:id="@+id/flResizeBR"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivResizeBR"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_resize_corner_br"
            android:contentDescription="Crop Resize Bottom Right" />
    </FrameLayout>
</FrameLayout>
